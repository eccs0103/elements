{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "elements-arena",
	"compatibility_date": "2026-11-16",
	"main": "controllers/arena-worker.ts",
	"workers_dev": false,
	"routes": [
		{ "pattern": "elements.eccs.dev/api/*", "zone_name": "eccs.dev" }
	],
	"vars": {
		"TURNSTILE_HOSTNAMES": ["elements.eccs.dev"]
	},
	"d1_databases": [
		{ "binding": "LEDGER", "database_name": "elements-ledger", "database_id": "e265bac9-fef3-4841-9639-84a503d622e0", "migrations_dir": "migrations" }
	],
	"observability": {
		"enabled": true
	}
}
